# DEBUG=true libera defaults de conveniencia para rodar localmente.
# Em producao use DEBUG=false: o boot passa a exigir um JWT_SECRET forte.
DEBUG=true
DATABASE_URL=sqlite:///./agenda.db
# Gere um segredo forte (>= 32 chars), ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-isso-por-um-segredo-forte-de-32+chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FREE_PLAN_MAX_SERVICES=3
RATE_LIMIT_ENABLED=true
